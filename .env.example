# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Google Gemini (https://aistudio.google.com/app/apikey) ---
GEMINI_API_KEY=your-gemini-api-key
# gemini-1.5-flash is retired by Google; use a current Flash model
GEMINI_MODEL=gemini-2.5-flash

# --- Firebase Realtime Database ---
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
# Option A: path to the service-account JSON (Project settings > Service accounts)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
# Option B (e.g. Streamlit Cloud): paste the whole JSON on one line instead of A
FIREBASE_CREDENTIALS_JSON=

# --- Lecturer mode ---
LECTURER_PIN=1234
